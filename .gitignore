# =========================================================================
# Bvlog — Açık Kaynak Dağıtım .gitignore
# Not: Paylaşımlı hosting kullanıcılarının Node.js kurmadan doğrudan
# çalıştırabilmesi için derlenmiş /assets dizini repoya DAHİL tutulur.
# =========================================================================

# Bağımlılıklar & Dağıtım Paketleri
/node_modules/
/vendor/
/dist/

# Kurulum Sihirbazı Tarafından Oluşturulan Yerel Yapılandırma & Kilit Dosyaları
/config/database.php
/storage/installed.lock
/storage/quarantine.json

# Kullanıcı Yüklemeleri, Önbellek ve Loglar (Klasör yapısını .gitkeep ile koru)
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/uploads/.htaccess

/storage/logs/*
!/storage/logs/.gitkeep
!/storage/logs/.htaccess

/storage/cache/*
!/storage/cache/.gitkeep
!/storage/cache/.htaccess

# Ortam Değişkenleri
.env
.env.*
!.env.example

# IDE & Editör Dosyaları
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# İşletim Sistemi & Geçici Dosyalar
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
