# Nginx örnek sunucu bloğu
# .htaccess Nginx'te uygulanmaz. Hassas dizinler ve çekirdek dosyalar burada kapatılır.
# site kökünü ve PHP soketini kendi sunucunuza göre değiştirin.
# Bu dosya http bloğu içinde (örn. sites-enabled/) yüklenmelidir; map yönergesi orada geçerlidir.

# asset() ile üretilen ?v=<dosya zamanı> adresleri içerik değişince değişir.
map $arg_v $bvlog_static_cache {
    default    "public, max-age=2592000";
    ~^[0-9]+$  "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name example.com;
    root /var/www/bvlog;
    index index.php;

    client_max_body_size 20m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json
               application/xml application/rss+xml image/svg+xml font/ttf;

    location ~ /\.(?!well-known) {
        deny all;
    }

    location ~ ^/(app|core|config|resources|node_modules|dist|tests|storage/logs|storage/cache)(/|$) {
        deny all;
    }

    location ~ ^/(schema\.sql|package\.json|package-lock\.json|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|build-release\.php|phpstan\.neon\.dist|phpstan-baseline\.neon|cron\.php)$ {
        deny all;
    }

    location ~ ^/(themes|plugins|storage)/.*\.php$ {
        deny all;
    }

    location ^~ /storage/uploads/ {
        location ~* \.(php|phtml|phar|cgi|pl|py|sh)$ {
            deny all;
        }
        expires 30d;
    }

    # Statik dosyalar: yukaridaki engelleme kurallarindan sonra gelmelidir.
    location ~* \.(css|js|woff2?|ttf|svg|png|jpe?g|gif|webp|avif|ico)$ {
        add_header Cache-Control $bvlog_static_cache;
        access_log off;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
}
