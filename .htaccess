<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Gizli dosyalara (.git, .env vb.) doğrudan erişimi engelle (.well-known hariç)
    RewriteRule ^\.(?!well-known) - [F,L]

    # Hassas sistem dizinlerine doğrudan erişimi engelle
    RewriteRule ^(app|core|config|resources|node_modules|dist|storage/logs|storage/cache)(/.*)?$ - [F,L]
    RewriteRule ^(schema\.sql|package\.json|package-lock\.json|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|build-release\.php|\.env|storage/installed\.lock|storage/safe_mode\.flag)$ - [F,L]

    # themes, plugins ve storage altındaki hiçbir .php dosyasına doğrudan URL ile erişilemez
    RewriteRule ^(themes|plugins|storage)/.*\.php$ - [F,L]

    # Statik dosyalar (assets, storage/uploads, themes/*/assets) mevcutsa doğrudan sun
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Diğer tüm istekleri index.php'ye yönlendir
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Dizin listelemeyi kapat
Options -Indexes

# Güvenlik Başlıkları
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
