# Yüklenen dizinde hiçbir PHP veya betik dosyasının çalıştırılmasını engelle
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|jsp|asp|aspx|sh|cgi|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
